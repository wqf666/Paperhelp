\documentclass[conference]{IEEEtran}
\usepackage[utf8]{inputenc}
\usepackage{graphicx}
\usepackage{amsmath}
\usepackage{cite}
\usepackage{hyperref}

\title{ {{ title }} }

\begin{document}
\maketitle

\begin{abstract}
{{ abstract }}
\end{abstract}

{% for section in sections %}
\section{ {{ section.title }} }
{{ section.content }}

{% for figure in section.figures %}
\begin{figure}[htbp]
\centering
\includegraphics[width=0.8\columnwidth]{ {{ figure.file_path | default("figures/placeholder") }} }
\caption{ {{ figure.caption | default("") }} }
\label{fig:{{ figure.id | default("fig" ~ loop.index) }} }
\end{figure}
{% endfor %}

{% for table in section.tables %}
\begin{table}[htbp]
\centering
\caption{ {{ table.caption | default("") }} }
\label{tab:{{ table.id | default("tab" ~ loop.index) }} }
\begin{tabular}{| {{ "c|" * table.col_count }} }
\hline
{% for row in table.rows %}
{{ " & ".join(row | map("string") | list) }} \\
\hline
{% endfor %}
\end{tabular}
\end{table}
{% endfor %}

{% for eq in section.equations %}
\begin{equation}
\label{eq:{{ eq.id | default("eq" ~ loop.index) }} }
{{ eq.latex | default("") }}
\end{equation}
{% endfor %}

{% endfor %}

\bibliographystyle{IEEEtran}
\bibliography{references}

\input{ai_disclosure}

\end{document}
